ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
COHERE_API_KEY=               # opcional (reranking)
REGWATCH_API_KEY=             # obligatoria: clave que exige la API (cabecera X-API-Key); la UI la pide al abrirse
MAX_UPLOAD_MB=20              # opcional: tamaño máximo del PDF subido
DATABASE_URL=postgresql://user:pass@localhost:5432/regwatch
JIRA_API_TOKEN=...
JIRA_EMAIL=...                  # cuenta asociada al token; Jira Cloud exige Basic auth (email:token), no Bearer
JIRA_ENABLED=false             # true para crear tickets en JIRA
JIRA_BASE_URL=https://your-org.atlassian.net  # URL base de tu instancia JIRA
JIRA_PROJECT_KEY=COMPL          # clave del proyecto donde crear los tickets
TAVILY_API_KEY=                # opcional (web_search_regulation); sin ella, la tool lo indica en vez de simular resultados
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com
